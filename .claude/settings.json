{
  "permissions": {
    "deny": ["Read(./node_modules/**)", "Read(./package-lock.json)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/trim-output.sh 2>/dev/null || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
